<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="o3p_google_drive.GoogleDriveExplorerField">
        <section class="o_o3p_drive_explorer"
                 t-ref="this.explorerRef"
                 t-att-class="this.state.isExpanded ? 'o_is_expanded' : ''"
                 aria-label="Google Drive explorer"
                 t-att-style="this.explorerStyle">
            <header class="o_o3p_drive_explorer_toolbar">
                <div class="btn-group" role="group" aria-label="Folder navigation">
                    <button type="button"
                            class="btn btn-light"
                            title="Back"
                            t-att-disabled="!this.state.canGoBack || this.state.loading || this.state.refreshing"
                            t-on-click="this.onBack">
                        <i class="oi oi-fw" data-icon="arrow_back" aria-hidden="true"/>
                    </button>
                    <button type="button"
                            class="btn btn-light"
                            title="Home"
                            t-att-disabled="this.state.isHome || this.state.loading || this.state.refreshing"
                            t-on-click="this.onHome">
                        <i class="oi oi-fw" data-icon="home" aria-hidden="true"/>
                    </button>
                    <button type="button"
                            class="btn btn-light"
                            title="Refresh current folder"
                            aria-label="Refresh current folder"
                            t-att-disabled="!this.state.folder || this.state.loading || this.state.refreshing"
                            t-on-click="this.onRefresh">
                        <i t-att-class="this.state.refreshing ? 'oi oi-fw oi-spin' : 'oi oi-fw'"
                           data-icon="autorenew"
                           aria-hidden="true"/>
                    </button>
                </div>

                <div class="o_o3p_drive_explorer_location text-truncate">
                    <i class="oi oi-fw oi-filled me-2"
                       data-icon="folder"
                       aria-hidden="true"/>
                    <span t-out="this.state.folder ? this.state.folder.name : 'Explorer'"/>
                </div>

                <button type="button"
                        class="btn btn-light ms-auto"
                        title="Open this folder in Google Drive"
                        t-att-disabled="!this.state.folder || !this.state.folder.web_view_link"
                        t-on-click="this.onOpenCurrentInDrive">
                    <i class="oi oi-fw" data-icon="open_in_new" aria-hidden="true"/>
                    <span class="d-none d-lg-inline ms-1">Open in Google Drive</span>
                </button>

                <div class="btn-group" role="group" aria-label="View mode">
                    <button type="button"
                            title="Details view"
                            t-attf-class="btn btn-light {{ this.state.viewMode === 'details' ? 'active' : '' }}"
                            t-on-click="this.onSetDetailsView">
                        <i class="oi oi-fw"
                           data-icon="format_list_bulleted"
                           aria-hidden="true"/>
                    </button>
                    <button type="button"
                            title="Thumbnail and icon view"
                            t-attf-class="btn btn-light {{ this.state.viewMode === 'icons' ? 'active' : '' }}"
                            t-on-click="this.onSetIconsView">
                        <i class="oi oi-fw" data-icon="grid_view" aria-hidden="true"/>
                    </button>
                    <button type="button"
                            role="switch"
                            t-att-aria-checked="this.state.isExpanded ? 'true' : 'false'"
                            t-att-aria-label="this.state.isExpanded ? 'Restore explorer height' : 'Double explorer height'"
                            t-att-title="this.state.isExpanded ? 'Restore explorer height' : 'Double explorer height'"
                            t-attf-class="btn btn-light {{ this.state.isExpanded ? 'active' : '' }}"
                            t-on-click="this.onToggleHeight">
                        <i class="oi oi-fw"
                           t-att-data-icon="this.state.isExpanded ? 'fullscreen_exit' : 'expand_content'"
                           aria-hidden="true"/>
                    </button>
                </div>
            </header>

            <div t-if="this.state.loading" class="o_o3p_drive_explorer_loading">
                <i class="oi oi-fw oi-spin me-2"
                   data-icon="autorenew"
                   aria-hidden="true"/>
                Loading folder…
            </div>

            <div t-elif="!this.state.folder" class="o_o3p_drive_explorer_empty">
                Save this Google Drive item to initialize the explorer.
            </div>

            <div t-elif="!this.state.items.length" class="o_o3p_drive_explorer_empty">
                This folder has no synchronized items.
            </div>

            <div t-elif="this.state.viewMode === 'details'" class="table-responsive">
                <table class="table table-hover table-sm o_o3p_drive_explorer_table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Modified</th>
                            <th class="text-end">Size</th>
                            <th class="o_o3p_drive_explorer_context_column"/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="this.state.items" t-as="item" t-key="item.id">
                            <td>
                                <button type="button"
                                        class="btn btn-link o_o3p_drive_explorer_name"
                                        t-att-class="item.is_folder ? 'btn btn-link o_o3p_drive_explorer_name o_is_folder' : 'btn btn-link o_o3p_drive_explorer_name'"
                                        t-att-data-item-id="item.id"
                                        t-on-click="this.onOpenItem">
                                    <img t-if="item.thumbnail_url"
                                         class="o_o3p_drive_explorer_detail_thumb"
                                         t-att-src="item.thumbnail_url"
                                         t-att-alt="item.name"/>
                                    <i t-elif="item.thumbnail_loading"
                                       class="oi oi-fw oi-spin text-muted"
                                       data-icon="autorenew"
                                       aria-hidden="true"/>
                                    <i t-else=""
                                       t-att-class="item.is_folder ? 'oi oi-fw oi-filled text-warning' : item.mime_type === 'application/pdf' ? 'oi oi-fw oi-filled text-danger' : 'oi oi-fw oi-filled text-muted'"
                                       t-att-data-icon="item.is_folder ? 'folder' : item.mime_type === 'application/pdf' ? 'picture_as_pdf' : item.mime_type.startsWith('image/') ? 'image' : item.mime_type.startsWith('video/') ? 'videocam' : 'article'"
                                       aria-hidden="true"/>
                                    <span class="ms-2" t-out="item.name"/>
                                </button>
                            </td>
                            <td t-out="item.mime_type"/>
                            <td t-out="item.modified_time || ''"/>
                            <td class="text-end" t-out="this.formatSize(item.size)"/>
                            <td class="o_o3p_drive_explorer_context_cell">
                                <button type="button"
                                        class="btn btn-link btn-sm"
                                        title="Item actions"
                                        aria-label="Item actions"
                                        t-att-data-item-id="item.id"
                                        t-on-click.stop="this.onToggleContext">
                                    <i class="oi oi-fw"
                                       data-icon="more_vert"
                                       aria-hidden="true"/>
                                </button>
                                <div t-if="this.state.contextItemId === item.id"
                                     class="o_o3p_drive_explorer_context_menu">
                                    <button t-foreach="item.actions"
                                            t-as="action"
                                            t-key="action.id"
                                            type="button"
                                            class="dropdown-item"
                                            t-att-data-item-id="item.id"
                                            t-att-data-action-id="action.id"
                                            t-on-click="this.onRunAdditionalAction">
                                        <i class="oi oi-fw me-2"
                                           t-att-data-icon="action.icon"
                                           aria-hidden="true"/>
                                        <t t-out="action.name"/>
                                    </button>
                                    <button t-if="this.canSetContactImage(item)"
                                            type="button"
                                            class="dropdown-item"
                                            t-att-disabled="this.state.settingContactImageItemId === item.id"
                                            t-att-data-item-id="item.id"
                                            t-on-click="this.onSetContactImage">
                                        <i class="oi oi-fw me-2"
                                           data-icon="person"
                                           aria-hidden="true"/>
                                        Set as contact image
                                    </button>
                                    <button t-if="item.web_view_link"
                                            type="button"
                                            class="dropdown-item"
                                            t-att-data-item-id="item.id"
                                            t-on-click="this.onOpenItemInDrive">
                                        <i class="oi oi-fw me-2"
                                           data-icon="open_in_new"
                                           aria-hidden="true"/>
                                        Open in Google Drive
                                    </button>
                                    <span t-if="!item.actions.length &amp;&amp; !item.web_view_link &amp;&amp; !this.canSetContactImage(item)">Actions for this MIME type will appear here.</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div t-else="" class="o_o3p_drive_explorer_grid">
                <article t-foreach="this.state.items"
                         t-as="item"
                         t-key="item.id"
                         class="o_o3p_drive_explorer_card">
                    <button type="button"
                            class="o_o3p_drive_explorer_card_open"
                            t-att-class="item.is_folder ? 'o_o3p_drive_explorer_card_open o_is_folder' : 'o_o3p_drive_explorer_card_open'"
                            t-att-data-item-id="item.id"
                            t-on-click="this.onOpenItem">
                        <span class="o_o3p_drive_explorer_card_visual">
                            <img t-if="item.thumbnail_url"
                                 t-att-src="item.thumbnail_url"
                                 t-att-alt="item.name"/>
                            <i t-elif="item.thumbnail_loading"
                               class="oi oi-fw oi-spin text-muted"
                               data-icon="autorenew"
                               aria-hidden="true"/>
                            <i t-elif="item.is_folder"
                               class="oi oi-fw oi-filled text-warning"
                               data-icon="folder"
                               aria-hidden="true"/>
                            <i t-else=""
                               t-att-class="item.mime_type === 'application/pdf' ? 'oi oi-fw oi-filled text-danger' : 'oi oi-fw oi-filled text-muted'"
                               t-att-data-icon="item.mime_type === 'application/pdf' ? 'picture_as_pdf' : item.mime_type.startsWith('image/') ? 'image' : item.mime_type.startsWith('video/') ? 'videocam' : 'article'"
                               aria-hidden="true"/>
                        </span>
                        <span class="o_o3p_drive_explorer_card_name" t-out="item.name"/>
                    </button>
                    <button type="button"
                            class="btn btn-light btn-sm o_o3p_drive_explorer_card_context"
                            title="Item actions"
                            aria-label="Item actions"
                            t-att-data-item-id="item.id"
                            t-on-click.stop="this.onToggleContext">
                        <i class="oi oi-fw" data-icon="more_vert" aria-hidden="true"/>
                    </button>
                    <div t-if="this.state.contextItemId === item.id"
                         class="o_o3p_drive_explorer_context_menu">
                        <button t-foreach="item.actions"
                                t-as="action"
                                t-key="action.id"
                                type="button"
                                class="dropdown-item"
                                t-att-data-item-id="item.id"
                                t-att-data-action-id="action.id"
                                t-on-click="this.onRunAdditionalAction">
                            <i class="oi oi-fw me-2"
                               t-att-data-icon="action.icon"
                               aria-hidden="true"/>
                            <t t-out="action.name"/>
                        </button>
                        <button t-if="this.canSetContactImage(item)"
                                type="button"
                                class="dropdown-item"
                                t-att-disabled="this.state.settingContactImageItemId === item.id"
                                t-att-data-item-id="item.id"
                                t-on-click="this.onSetContactImage">
                            <i class="oi oi-fw me-2"
                               data-icon="person"
                               aria-hidden="true"/>
                            Set as contact image
                        </button>
                        <button t-if="item.web_view_link"
                                type="button"
                                class="dropdown-item"
                                t-att-data-item-id="item.id"
                                t-on-click="this.onOpenItemInDrive">
                            <i class="oi oi-fw me-2"
                               data-icon="open_in_new"
                               aria-hidden="true"/>
                            Open in Google Drive
                        </button>
                        <span t-if="!item.actions.length &amp;&amp; !item.web_view_link &amp;&amp; !this.canSetContactImage(item)">Actions for this MIME type will appear here.</span>
                    </div>
                </article>
            </div>
        </section>
    </t>
</templates>
