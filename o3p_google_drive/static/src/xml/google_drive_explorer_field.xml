<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="o3p_google_drive.GoogleDriveExplorerField">
        <section class="o_o3p_drive_explorer" aria-label="Google Drive explorer">
            <header class="o_o3p_drive_explorer_toolbar">
                <div class="btn-group" role="group" aria-label="Folder navigation">
                    <button type="button"
                            class="btn btn-light"
                            title="Back"
                            t-att-disabled="!state.canGoBack || state.loading"
                            t-on-click="onBack">
                        <i class="fa fa-arrow-left" aria-hidden="true"/>
                    </button>
                    <button type="button"
                            class="btn btn-light"
                            title="Home"
                            t-att-disabled="state.isHome || state.loading"
                            t-on-click="onHome">
                        <i class="fa fa-home" aria-hidden="true"/>
                    </button>
                </div>

                <div class="o_o3p_drive_explorer_location text-truncate">
                    <i class="fa fa-folder-open me-2" aria-hidden="true"/>
                    <span t-out="state.folder ? state.folder.name : 'Explorer'"/>
                </div>

                <div class="btn-group ms-auto" role="group" aria-label="View mode">
                    <button type="button"
                            title="Details view"
                            t-attf-class="btn btn-light {{ state.viewMode === 'details' ? 'active' : '' }}"
                            t-on-click="onSetDetailsView">
                        <i class="fa fa-list" aria-hidden="true"/>
                    </button>
                    <button type="button"
                            title="Thumbnail and icon view"
                            t-attf-class="btn btn-light {{ state.viewMode === 'icons' ? 'active' : '' }}"
                            t-on-click="onSetIconsView">
                        <i class="fa fa-th-large" aria-hidden="true"/>
                    </button>
                </div>
            </header>

            <div t-if="state.loading" class="o_o3p_drive_explorer_loading">
                <i class="fa fa-spinner fa-spin me-2" aria-hidden="true"/>
                Loading folder…
            </div>

            <div t-elif="!state.folder" class="o_o3p_drive_explorer_empty">
                Save this Google Drive item to initialize the explorer.
            </div>

            <div t-elif="!state.items.length" class="o_o3p_drive_explorer_empty">
                This folder has no synchronized items.
            </div>

            <div t-elif="state.viewMode === 'details'" class="table-responsive">
                <table class="table table-hover table-sm o_o3p_drive_explorer_table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Modified</th>
                            <th class="text-end">Size</th>
                            <th class="o_o3p_drive_explorer_context_column"/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.items" t-as="item" t-key="item.id">
                            <td>
                                <button type="button"
                                        class="btn btn-link o_o3p_drive_explorer_name"
                                        t-att-class="item.is_folder ? 'btn btn-link o_o3p_drive_explorer_name o_is_folder' : 'btn btn-link o_o3p_drive_explorer_name'"
                                        t-att-data-item-id="item.id"
                                        t-on-click="onOpenItem">
                                    <img t-if="item.thumbnail_url"
                                         class="o_o3p_drive_explorer_detail_thumb"
                                         t-att-src="item.thumbnail_url"
                                         t-att-alt="item.name"/>
                                    <i t-else=""
                                       t-att-class="item.is_folder ? 'fa fa-folder text-warning' : 'fa fa-file-o text-muted'"
                                       aria-hidden="true"/>
                                    <span class="ms-2" t-out="item.name"/>
                                </button>
                            </td>
                            <td t-out="item.mime_type"/>
                            <td t-out="item.modified_time || ''"/>
                            <td class="text-end" t-out="formatSize(item.size)"/>
                            <td class="o_o3p_drive_explorer_context_cell">
                                <button type="button"
                                        class="btn btn-link btn-sm"
                                        title="Item actions"
                                        aria-label="Item actions"
                                        t-att-data-item-id="item.id"
                                        t-on-click.stop="onToggleContext">
                                    <i class="fa fa-ellipsis-v" aria-hidden="true"/>
                                </button>
                                <div t-if="state.contextItemId === item.id"
                                     class="o_o3p_drive_explorer_context_menu">
                                    <span>Actions for this MIME type will appear here.</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div t-else="" class="o_o3p_drive_explorer_grid">
                <article t-foreach="state.items"
                         t-as="item"
                         t-key="item.id"
                         class="o_o3p_drive_explorer_card">
                    <button type="button"
                            class="o_o3p_drive_explorer_card_open"
                            t-att-class="item.is_folder ? 'o_o3p_drive_explorer_card_open o_is_folder' : 'o_o3p_drive_explorer_card_open'"
                            t-att-data-item-id="item.id"
                            t-on-click="onOpenItem">
                        <span class="o_o3p_drive_explorer_card_visual">
                            <img t-if="item.thumbnail_url"
                                 t-att-src="item.thumbnail_url"
                                 t-att-alt="item.name"/>
                            <i t-elif="item.is_folder"
                               class="fa fa-folder text-warning"
                               aria-hidden="true"/>
                            <i t-else="" class="fa fa-file-o text-muted" aria-hidden="true"/>
                        </span>
                        <span class="o_o3p_drive_explorer_card_name" t-out="item.name"/>
                    </button>
                    <button type="button"
                            class="btn btn-light btn-sm o_o3p_drive_explorer_card_context"
                            title="Item actions"
                            aria-label="Item actions"
                            t-att-data-item-id="item.id"
                            t-on-click.stop="onToggleContext">
                        <i class="fa fa-ellipsis-v" aria-hidden="true"/>
                    </button>
                    <div t-if="state.contextItemId === item.id"
                         class="o_o3p_drive_explorer_context_menu">
                        <span>Actions for this MIME type will appear here.</span>
                    </div>
                </article>
            </div>
        </section>
    </t>
</templates>
