<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="google_drive_explorer_test_view_list" model="ir.ui.view">
        <field name="name">o3p.google.drive.explorer.test.list</field>
        <field name="model">o3p.google.drive.explorer.test</field>
        <field name="arch" type="xml">
            <list string="Google Drive Explorer Tests">
                <field name="name"/>
                <field name="google_item_id"/>
            </list>
        </field>
    </record>

    <record id="google_drive_explorer_test_view_form" model="ir.ui.view">
        <field name="name">o3p.google.drive.explorer.test.form</field>
        <field name="model">o3p.google.drive.explorer.test</field>
        <field name="arch" type="xml">
            <form string="Google Drive Explorer Test">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Test name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="google_item_id"
                               domain="[('mime_type', '=', 'application/vnd.google-apps.folder')]"/>
                    </group>
                    <separator string="Explorer"/>
                    <field name="google_item_id"
                           widget="o3p_google_drive_explorer"
                           nolabel="1"
                           readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_google_drive_explorer_test" model="ir.actions.act_window">
        <field name="name">Explorer Tests</field>
        <field name="res_model">o3p.google.drive.explorer.test</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_o3p_google_drive_explorer_test"
              name="Explorer Tests"
              parent="menu_o3p_google_drive_technical"
              action="action_google_drive_explorer_test"
              groups="base.group_system"
              sequence="30"/>
</odoo>
