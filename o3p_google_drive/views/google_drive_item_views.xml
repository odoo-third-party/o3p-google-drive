<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="google_drive_item_view_list" model="ir.ui.view">
        <field name="name">o3p.google.drive.item.list</field>
        <field name="model">o3p.google.drive.item</field>
        <field name="arch" type="xml">
            <list string="Google Drive Items"
                  default_order="id desc"
                  decoration-muted="trashed">
                <field name="name"/>
                <field name="gid"/>
                <field name="is_starting_point" optional="show"/>
                <field name="mime_type" optional="show"/>
                <field name="drive_id" optional="show"/>
                <field name="parent_gids" optional="hide"/>
                <field name="modified_time" optional="show"/>
                <field name="meta_fetched_at" optional="show"/>
                <field name="trashed" optional="show"/>
            </list>
        </field>
    </record>

    <record id="google_drive_item_view_form" model="ir.ui.view">
        <field name="name">o3p.google.drive.item.form</field>
        <field name="model">o3p.google.drive.item</field>
        <field name="arch" type="xml">
            <form string="Google Drive Item">
                <header>
                    <button name="action_refresh_meta"
                            type="object"
                            string="Refresh Metadata"
                            icon="fa-refresh"
                            class="btn-primary"/>
                    <button name="action_deeper_refresh"
                            type="object"
                            string="Deeper Refresh"
                            icon="fa-level-down"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Google Drive">
                            <field name="gid"/>
                            <field name="is_starting_point"/>
                            <field name="mime_type" readonly="1"/>
                            <field name="drive_id" readonly="1"/>
                            <field name="parent_gids" readonly="1"/>
                            <field name="web_view_link" readonly="1" widget="url"/>
                        </group>
                        <group string="Metadata">
                            <field name="meta_fetched_at" readonly="1"/>
                            <field name="created_time" readonly="1"/>
                            <field name="modified_time" readonly="1"/>
                            <field name="trashed" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Metadata" name="raw_metadata">
                            <field name="meta" nolabel="1"/>
                        </page>
                        <page string="Thumbnails" name="thumbnails">
                            <field name="thumbnail_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="image" widget="image"/>
                                    <field name="kind"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                    <field name="byte_length"/>
                                    <field name="refreshed_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="google_drive_item_view_search" model="ir.ui.view">
        <field name="name">o3p.google.drive.item.search</field>
        <field name="model">o3p.google.drive.item</field>
        <field name="arch" type="xml">
            <search string="Google Drive Items">
                <field name="name"/>
                <field name="gid"/>
                <filter name="starting_points"
                        string="Starting Points"
                        domain="[('is_starting_point', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_google_drive_item" model="ir.actions.act_window">
        <field name="name">Google Drive Items</field>
        <field name="res_model">o3p.google.drive.item</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="google_drive_item_view_search"/>
        <field name="context">{
            'default_is_starting_point': True,
            'search_default_starting_points': 1,
        }</field>
    </record>

    <menuitem id="menu_o3p_google_drive_technical"
              name="O3P Google Drive"
              parent="base.menu_custom"
              groups="base.group_system"
              sequence="90"/>

    <menuitem id="menu_o3p_google_drive_item"
              name="Items"
              parent="menu_o3p_google_drive_technical"
              action="action_google_drive_item"
              groups="base.group_system"
              sequence="10"/>
</odoo>
